  "lines": [
    { "id": "maya-seat", "at": 3.6, "who": "Maya", "text": "I saved you a seat.", "treatment": "close" },
    { "id": "narr-little", "at": 8.0, "who": "Narrator", "text": "When you live far apart, it's the little things you miss.", "treatment": "narrator" },
    { "id": "maya-loved", "at": 21.35, "who": "Maya", "text": "You would've loved this.", "treatment": "outdoors" },
    { "id": "narr-leave", "at": 28.5, "who": "Narrator", "text": "With SameSky, leave a little of your day for someone you love.", "treatment": "narrator" },
    { "id": "maya-note", "at": 51.4, "who": "Maya (recorded message)", "text": "I saw this and thought of you. Sit with me for a minute?", "treatment": "recorded" },
    { "id": "narr-object", "at": 56.9, "who": "Narrator", "text": "A familiar object. A voice waiting just for you.", "treatment": "narrator" },
    { "id": "adam-wish", "at": 73.0, "who": "Adam", "text": "I wish I'd been there. Tell me everything.", "treatment": "room" },
    { "id": "maya-made", "at": 88.4, "who": "Maya", "text": "You made it.", "treatment": "room" },
    { "id": "adam-saved", "at": 93.4, "who": "Adam", "text": "You saved me a seat.", "treatment": "room" },
    { "id": "narr-meet", "at": 97.6, "who": "Narrator", "text": "And when your days finally meet, share the same space.", "treatment": "narrator" },
    { "id": "maya-tomorrow", "at": 109.0, "who": "Maya", "text": "Same time tomorrow?", "treatment": "room" },
    { "id": "adam-seat", "at": 111.9, "who": "Adam", "text": "Same seat.", "treatment": "room" }
