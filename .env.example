# Copy to .env (never commit real values). Every secret below stays on the server.

# --- API + worker ---------------------------------------------------------
# SQLite for local development; Postgres (e.g. Supabase Postgres) in production:
#   DATABASE_URL=postgresql+psycopg://samesky_api:<password>@<host>:5432/postgres
# Default when unset: SQLite at api/data/samesky.db
# DATABASE_URL=
# Long random string used to sign access tokens, media URLs and confirmation tokens.
SAMESKY_SECRET_KEY=change-me-to-64-random-characters
# Default when unset: api/data/media
# SAMESKY_MEDIA_ROOT=
# Leave empty to serve media with relative URLs (works behind the Vite proxy and on a LAN headset).
SAMESKY_PUBLIC_API_URL=
SAMESKY_CORS_ORIGINS=http://localhost:5173,https://localhost:5173

# Optional: accept Supabase Auth JWTs as identity (HS256 project JWT secret).
SUPABASE_JWT_SECRET=

# Optional AI recap drafting. Without a key, recaps use the clearly labelled chronological fallback.
ANTHROPIC_API_KEY=
SAMESKY_AI_MODEL=claude-opus-5-5
SAMESKY_AI_TIMEOUT=45
SAMESKY_AI_DAILY_LIMIT=6

# Web Push (VAPID). Generate with: api/.venv/Scripts/python scripts/gen_vapid.py
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- Web (Vite) ------------------------------------------------------------
# Empty = same origin (/v1 is proxied to the API in development).
VITE_API_URL=
