{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "C:/Program Files/nodejs/node.exe",
      "runtimeArgs": ["web/node_modules/vite/bin/vite.js", "web", "--strictPort", "--port", "5173"],
      "port": 5173
    },
    {
      "name": "api",
      "runtimeExecutable": "api/.venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "uvicorn", "samesky.main:app", "--app-dir", "api", "--port", "8000"],
      "port": 8000
    }
  ]
}
